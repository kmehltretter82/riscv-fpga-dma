         .init_ni           (init_ctrl_cache_n),
         // I$
         .icache_en_i       (icache_en_csr),
@@ -1462,11 +1508,11 @@
         .wbuffer_empty_o   (dcache_commit_wbuffer_empty),
         .wbuffer_not_ni_o  (dcache_commit_wbuffer_not_ni),
