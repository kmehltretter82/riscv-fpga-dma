-        .inval_valid_i     (inval_valid),
-        .inval_ready_o     (inval_ready)
+        .noc_req_o         (wt_noc_req),
+        .noc_resp_i        (wt_noc_resp),
+        .inval_addr_i      (coherent_inval_addr),
+        .inval_valid_i     (coherent_inval_valid),
+        .inval_ready_o     (coherent_inval_ready)
     );
   end else if (
         CVA6Cfg.DCacheType == config_pkg::HPDCACHE_WT ||
@@ -1538,6 +1584,8 @@
         .noc_resp_i(noc_resp_i)
     );
     assign inval_ready = 1'b1;
+    assign dma_cache_quiesce_ack_o = 1'b0;
+    assign dma_cache_inval_ready_o = 1'b0;
   end else begin : gen_cache_wb
     std_cache_subsystem #(
         // note: this only works with one cacheable region
@@ -1593,6 +1641,8 @@
     );
