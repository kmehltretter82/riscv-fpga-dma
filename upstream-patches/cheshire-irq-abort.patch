+  // The error handler uses a request/response protocol: accept the error
+  // notification, stop consuming responses while submitting the selected
+  // action, then resume the response channel for transfer completion.
+  typedef enum logic [1:0] {
+    EhAcceptRsp,
+    EhSendAction,
+    EhWaitCompletion
+  } eh_state_t;
+  eh_state_t eh_state_d, eh_state_q;
+  logic eh_sw_abort_d, eh_sw_abort_q;
+
+  always_comb begin
+    eh_state_d = eh_state_q;
+    eh_sw_abort_d = eh_sw_abort_q;
+    idma_rsp_ready = 1'b0;
+    idma_rsp_forward_valid = 1'b0;
+    idma_eh_req_valid = 1'b0;
+    sw_abort_accepted = 1'b0;
+    unique case (eh_state_q)
+      EhAcceptRsp: begin
+        idma_rsp_ready = idma_rsp_sink_ready;
+        idma_rsp_forward_valid = idma_rsp_valid;
+        if (idma_rsp_valid && idma_rsp_ready && idma_rsp.error) begin
+          eh_sw_abort_d = 1'b0;
+          eh_state_d = EhSendAction;
+        end else if (!idma_rsp_valid && sw_abort_pending) begin
+          eh_sw_abort_d = 1'b1;
+          eh_state_d = EhSendAction;
+        end
+      end
+      EhSendAction: begin
+        idma_eh_req_valid = 1'b1;
+        if (idma_eh_req_ready) begin
+          sw_abort_accepted = eh_sw_abort_q;
+          eh_state_d = EhWaitCompletion;
+        end
+      end
+      EhWaitCompletion: begin
+        idma_rsp_ready = idma_rsp_sink_ready;
+        idma_rsp_forward_valid = idma_rsp_valid;
+        if (idma_rsp_valid && idma_rsp_ready) begin
+          if (idma_rsp.error)
+            eh_state_d = EhSendAction;
+          else begin
+            eh_sw_abort_d = 1'b0;
+            eh_state_d = EhAcceptRsp;
+          end
+        end
+      end
+      default: eh_state_d = EhAcceptRsp;
+    endcase
+  end
+
+  always_ff @(posedge clk_i or negedge rst_ni) begin
+    if (!rst_ni) begin
+      eh_state_q <= EhAcceptRsp;
+      eh_sw_abort_q <= 1'b0;
+    end else begin
+      eh_state_q <= eh_state_d;
+      eh_sw_abort_q <= eh_sw_abort_d;
+    end
+  end
