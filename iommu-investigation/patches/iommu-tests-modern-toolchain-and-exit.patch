 #include "8250_uart.h"
 uart8250_t * uart = (uart8250_t *) (0x10000000) ;
+
+/*
+ * Picolibc's tinystdio deliberately leaves the standard streams to the
+ * board support package.  The original project used newlib's _write hook;
+ * provide the equivalent stream object so the same test binary can be built
+ * with Ubuntu's relocatable bare-metal toolchain.
+ */
+static int uart_stdio_put(char c, FILE *stream)
+{
+    (void)stream;
+    if (c == '\n')
+        uart_putc(uart, '\r');
+    uart_putc(uart, c);
+    return (unsigned char)c;
+}
+
+static FILE uart_stdout = FDEV_SETUP_STREAM(uart_stdio_put, NULL, NULL,
+                                             _FDEV_SETUP_WRITE);
+FILE *const stdout = &uart_stdout;
+FILE *const stderr = &uart_stdout;
+FILE *const stdin = NULL;
