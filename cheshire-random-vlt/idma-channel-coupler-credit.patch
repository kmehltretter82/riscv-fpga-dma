-        if (aw_ready_decoupled & first) begin
+        // A decoupled AW at the head is released without consuming a credit.
+        // Preserve a simultaneous credit for the next coupled AW.
+        if (aw_valid & aw_decoupled_head) begin
             aw_sent = 1'b1;
+            if (first) begin
