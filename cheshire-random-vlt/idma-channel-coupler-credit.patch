+        assign first = w_req_valid_i & w_req_first_i &
+                       ~aw_stall_q & ~w_decouple_aw_i;
+        assign aw_stall_d = w_req_valid_i & ~w_req_ready_i;
+    end else begin : gen_read_data_credits
+        // Legacy behavior: one credit for every first R beat.
+        assign first = r_rsp_valid_i & r_rsp_ready_i &
